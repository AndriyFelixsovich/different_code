//ВИДАЛЯЄМО ПРОБІЛИ З НАЗВИ

$folder = __DIR__ . "/-foto";

// Перевіряємо, чи існує папка
if (!is_dir($folder)) {
    die("Папка '$folder' не існує.");
}

// Отримуємо список файлів у папці
$files = scandir($folder);

// Перебираємо файли
foreach ($files as $file) {
    // Пропускаємо поточну директорію та батьківську директорію
    if ($file == "." || $file == "..") {
        continue;
    }

    $filePath = $folder . "/" . $file;

    // Перевіряємо, чи це файл (не директорія)
    if (is_file($filePath)) {
        // Видаляємо пробіли з назви файлу
        $newFileName = str_replace(" ", "", $file);
        $newFilePath = $folder . "/" . $newFileName;

        // Перейменовуємо файл
        if (rename($filePath, $newFilePath)) {
            echo "Файл '$file' перейменовано на '$newFileName'<br>";
        } else {
            echo "Помилка перейменування файлу '$file'<br>";
        }
    }
}

